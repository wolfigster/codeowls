<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>net.wolfig.codeowls</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Codeowls</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://wolfig.net">johannes</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        First-class editor support for <code>CODEOWNERS</code> files used by GitHub, GitLab, and Bitbucket.<br>
        <br>
        <b>Features</b>
        <ul>
          <li><b>Syntax highlighting</b> for comments, glob patterns (including GitLab
              negation <code>!/config/**/*.rb</code>), user / team / role / e-mail owners,
              GitLab section headers, optional sections, and approval counts &mdash;
              colors configurable under <em>Settings → Editor → Color Scheme → CODEOWNERS</em>.</li>
          <li><b>Status bar widget</b> showing the owners (and any required approval count) of the
              currently selected file; click to jump to the matching rule &mdash; or, when the file has no
              specific owner, to get confidence-ranked owner suggestions you can add to CODEOWNERS in one click.</li>
          <li><b>GitLab section support</b> &mdash; rules inherit their section's default owners
              (<code>[Documentation] @docs-team</code>) and approval count; a rule's own owners override the default.</li>
          <li><b>Inlay hints</b> displaying the number of files each glob rule matches in
              the current project; toggle via <em>Find Action → Codeowls: Toggle file count hints</em>.</li>
          <li><b>Matched-file navigation</b> &mdash; a gutter icon on each wildcard / directory
              rule lists the project files it matches; pick one to jump to it.</li>
          <li><b>Path completion</b> for glob patterns and <b>section-name completion</b> for GitLab
              <code>[Section]</code> headers already used in the file.</li>
          <li><b>Owner completion</b> drawn from owners already in the file, Git-history contributors,
              and the built-in GitLab roles (<code>@@developer</code>, <code>@@maintainer</code>, <code>@@owner</code>).</li>
          <li><b>Owner navigation</b> &mdash; Ctrl/Cmd+Click a user or team owner to open
              their GitHub / GitLab page (resolved from the repository's Git remote) in the browser.</li>
          <li><b>Move / rename sync</b> &mdash; rules pointing at a moved or renamed file or
              directory are rewritten to the new path automatically.</li>
          <li><b>Inspections</b> that warn about unnecessary rules &mdash; patterns matching no
              project file, and rules fully shadowed by a later rule &mdash; with a quick fix to remove them.</li>
          <li><b>Code folding</b> for GitLab section blocks.</li>
        </ul>
        Matches any file literally named <code>CODEOWNERS</code> &mdash; including
        <code>.github/CODEOWNERS</code>, <code>.gitlab/CODEOWNERS</code>, <code>docs/CODEOWNERS</code>,
        and a repository-root <code>CODEOWNERS</code>.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- CODEOWNERS language support -->
        <!-- Matches any file named CODEOWNERS, including .github/CODEOWNERS, .gitlab/CODEOWNERS, docs/CODEOWNERS -->
        <fileType name="CODEOWNERS"
                  implementationClass="net.wolfig.codeowls.lang.CodeownersFileType"
                  fieldName="INSTANCE"
                  language="CODEOWNERS"
                  patterns="CODEOWNERS"/>
        <lang.parserDefinition language="CODEOWNERS"
                               implementationClass="net.wolfig.codeowls.lang.CodeownersParserDefinition"/>
        <lang.syntaxHighlighterFactory language="CODEOWNERS"
                                       implementationClass="net.wolfig.codeowls.highlighting.CodeownersSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="net.wolfig.codeowls.settings.CodeownersColorSettingsPage"/>

        <!-- Folding for GitLab section headers -->
        <lang.foldingBuilder
                language="CODEOWNERS"
                implementationClass="net.wolfig.codeowls.folding.CodeownersFoldingBuilder"/>

        <!-- Status bar widget that shows the CODEOWNERS owners of the currently selected file. -->
        <statusBarWidgetFactory id="Codeowls.StatusBarWidget"
                                implementation="net.wolfig.codeowls.statusbar.CodeownersStatusBarWidgetFactory"/>

        <!-- Path and owner completion inside CODEOWNERS rules. -->
        <completion.contributor language="CODEOWNERS"
                                implementationClass="net.wolfig.codeowls.completion.CodeownersCompletionContributor"/>
        <typedHandler implementation="net.wolfig.codeowls.completion.CodeownersTypedHandler"/>

        <!-- Ctrl/Cmd+Click a user or team owner to open their GitHub/GitLab page. -->
        <gotoDeclarationHandler
                implementation="net.wolfig.codeowls.navigation.CodeownersOwnerGotoDeclarationHandler"/>

        <!-- Rewrite CODEOWNERS rule paths when a file/directory is moved or renamed. -->
        <refactoring.elementListenerProvider
                implementation="net.wolfig.codeowls.refactoring.CodeownersMoveRenameListenerProvider"/>

        <!-- Shift+F6 on a CODEOWNERS owner opens the owner refactoring dialog. -->
        <renameHandler implementation="net.wolfig.codeowls.refactoring.CodeownersOwnerRenameHandler"/>

        <!-- Gutter icon on wildcard/directory rules listing the files they match. -->
        <codeInsight.lineMarkerProvider
                language="CODEOWNERS"
                implementationClass="net.wolfig.codeowls.navigation.CodeownersMatchedFilesLineMarkerProvider"/>

        <!-- Flags unnecessary rules: patterns that match no project file, and
             rules fully shadowed by a later rule. -->
        <localInspection
                language="CODEOWNERS"
                implementationClass="net.wolfig.codeowls.inspection.CodeownersUnnecessaryRuleInspection"
                groupName="CODEOWNERS"
                enabledByDefault="true"
                level="WARNING" key="inspection.codeowners.unnecessary.rule.display.name"
                bundle="messages.CodeownersBundle"/>

        <!-- End-of-line inlay hints showing "N files" for each glob CODEOWNERS rule. -->
        <codeInsight.declarativeInlayProvider
                language="CODEOWNERS"
                providerId="codeowls.fileCount"
                bundle="messages.CodeownersBundle"
                nameKey="inlay.hints.file.count.name"
                descriptionKey="inlay.hints.file.count.description"
                implementationClass="net.wolfig.codeowls.inlay.CodeownersFileCountInlayHintsProvider"
                group="OTHER_GROUP"
                isEnabledByDefault="true"/>
    </extensions>

    <actions resource-bundle="messages.CodeownersBundle">
        <!-- Quick toggle for the file-count inlay hint — same persistent setting
             as Settings | Editor | Inlay Hints | CODEOWNERS | File count, but
             reachable from Find Action (Ctrl/Cmd+Shift+A). -->
        <action id="Codeowls.ToggleFileCountHints"
                class="net.wolfig.codeowls.inlay.ToggleCodeownersFileCountHintsAction"
                text="Codeowls: Toggle file count hints"
                description="_Enable or disable CODEOWNERS file count inlay hints_"/>

        <!-- "Codeowls" submenu on the Project View / Editor context menus. Hides
             itself when it has no applicable action (see CodeowlsActionGroup). -->
        <group id="Codeowls.ContextMenu"
               class="net.wolfig.codeowls.action.CodeowlsActionGroup"
               text="Codeowls"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="Codeowls.AddEntry"
                    class="net.wolfig.codeowls.entry.AddCodeownersEntryAction"
                    text="Codeowls: Add entry"
                    description="Add an ownership rule for the selected project file">
                <override-text place="EditorPopup" text="Add entry"/>
                <override-text place="ProjectViewPopup" text="Add entry"/>
            </action>

            <!-- Explain why a project file has its effective CODEOWNERS owner(s):
                 all matching rules, the winning rule, section inheritance, and
                 approval counts, with click-to-navigate. Also reachable from
                 Find Action via its full name. -->
            <action id="Codeowls.ExplainOwnership"
                    class="net.wolfig.codeowls.explain.ExplainCodeownersOwnershipAction"
                    text="Codeowls: Explain ownership"
                    description="Show the CODEOWNERS rules that determine this file's owners">
                <override-text place="EditorPopup" text="Explain ownership"/>
                <override-text place="ProjectViewPopup" text="Explain ownership"/>
            </action>

            <!-- Replace the owner under the caret inside its GitLab section or
                 across the whole CODEOWNERS file. Shows itself only when the
                 caret is on an owner token; also placed on the Refactor menu
                 (Shift+F6 goes through CodeownersOwnerRenameHandler) and
                 reachable from Find Action. -->
            <action id="Codeowls.RefactorOwner"
                    class="net.wolfig.codeowls.refactoring.RefactorCodeownersOwnerAction"
                    text="Codeowls: Refactor owner"
                    description="Replace this CODEOWNERS owner in the current section or the whole file">
                <override-text place="EditorPopup" text="Refactor owner"/>
                <override-text place="ProjectViewPopup" text="Refactor owner"/>
                <add-to-group group-id="RefactoringMenu" anchor="last"/>
            </action>
        </group>
    </actions>

</idea-plugin>
